end

local function Obfuscate(Source, Options)
    if Source == "" then
        return ""
    end

    local Output = EncodePayload(Source)

    if Options.Junk then
        local A = UID(2)
        local B = UID(2)
        local C = UID(2)

        Output = table.concat({
            "return(function()",
            "local ",
            A,
            "=",
            math.random(10000, 99999),
            ";",
            "local ",
            B,
            "={};",
            "local ",
            C,
            "=",
            A,
            "+",
            math.random(100, 999),
            ";",
            Output:sub(7),
            "end)()"
        })
    end

    return Output
end

