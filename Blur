local Busy = false

ObfBtn.MouseButton1Click:Connect(function()
    if Busy then return end
    local Src = InputBox.Text
    if Src == "" then
        SetStatusErr("No input source.")
        return
    end
    Busy = true
    SetStatusBusy("Obfuscating...")
    Tween(ObfBtn, 0.12, { BackgroundColor3 = Color3.fromRGB(80, 30, 135) }):Play()
    task.defer(function()
        local Result, Err = Obfuscate(Src, {
            RenameLocals  = OptRenameLocals.Value,
            EncodeStrings = OptEncodeStrings.Value,
            InsertJunk    = OptInsertJunk.Value,
            ObfuscateNums = OptObfNums.Value,
            StripComments = OptStripComments.Value,
            Minify        = OptMinify.Value,
        })
        if Err then
            OutputBox.Text = ""
            SetStatusErr("Error: " .. tostring(Err))
        else
            OutputBox.Text = Result
            local InLen  = #Src
            local OutLen = #Result
            local Ratio  = math.floor((OutLen / math.max(InLen, 1)) * 100)
            SetStatusOk(
                "Done — " .. tostring(InLen) .. " → " .. tostring(OutLen) .. " chars (" .. tostring(Ratio) .. "% size)"
            )
        end
        Tween(ObfBtn, 0.12, { BackgroundColor3 = Color3.fromRGB(110, 45, 185) }):Play()
        Busy = false
    end)
end)

CopyBtn.MouseButton1Click:Connect(function()
    local Text = OutputBox.Text
    if Text == "" then
        SetStatusErr("Nothing to copy.")
        return
    end
    local Copied = false
    if type(setclipboard) == "function" then
        pcall(setclipboard, Text)
        Copied = true
    elseif type(toclipboard) == "function" then
        pcall(toclipboard, Text)
        Copied = true
    elseif type(Clipboard) == "table" and type(Clipboard.set) == "function" then
        pcall(Clipboard.set, Text)
        Copied = true
    end
    if Copied then
        local PrevColor = CopyBtn.TextColor3
        local PrevText  = CopyBtn.Text
        CopyBtn.Text = "Copied!"
        Tween(CopyBtn, 0.12, { TextColor3 = Color3.fromRGB(100, 210, 120) }):Play()
        task.delay(1.4, function()
            CopyBtn.Text = PrevText
            Tween(CopyBtn, 0.12, { TextColor3 = PrevColor }):Play()
        end)
        SetStatusOk("Output copied to clipboard.")
    else
        SetStatusErr("Clipboard API not available in this executor.")
    end
end)

