local UsedNames = {}

local function RandomName()
    local Name

    repeat
        Name = UID(math.random(3, 7))
    until not Keywords[Name] and not UsedNames[Name]

    UsedNames[Name] = true
    return Name
end

local function ReadString(Source, Start)
    local Quote = Source:sub(Start, Start)
    local I = Start + 1
    local Escaped = false

    while I <= #Source do
        local C = Source:sub(I, I)

        if Escaped then
            Escaped = false
        elseif C == "\\" then
            Escaped = true
        elseif C == Quote then
            return Source:sub(Start, I), I + 1
        end

        I += 1
    end

    return Source:sub(Start), #Source + 1
end

local function ReadLongString(Source, Start)
    local I = Start + 1
    local Equals = 0

    while Source:sub(I, I) == "=" do
        Equals += 1
        I += 1
    end

    if Source:sub(I, I) ~= "[" then
        return nil
    end

    local Close = "]" .. string.rep("=", Equals) .. "]"
    local Finish = Source:find(Close, I + 1, true)

    if not Finish then
        return Source:sub(Start), #Source + 1
    end

    return Source:sub(Start, Finish + #Close - 1), Finish + #Close
end

local function Tokenize(Source)
    local Tokens = {}
    local I = 1

    while I <= #Source do
        local C = Source:sub(I, I)
        local N = Source:sub(I + 1, I + 1)

        if C:match("%s") then
            I += 1

        elseif C == "-" and N == "-" then
            local Long, Next = ReadLongString(Source, I + 2)

            if Long then
                Tokens[#Tokens + 1] = {
                    Type = "comment",
                    Value = "--" .. Long
                }
                I = Next
            else
                local Finish = Source:find("\n", I + 2, true) or (#Source + 1)

                Tokens[#Tokens + 1] = {
                    Type = "comment",
                    Value = Source:sub(I, Finish - 1)
                }

                I = Finish
            end

        elseif C == "\"" or C == "'" then
            local Value, Next = ReadString(Source, I)

            Tokens[#Tokens + 1] = {
                Type = "string",
                Value = Value
            }

            I = Next

        elseif C == "[" then
            local Value, Next = ReadLongString(Source, I)

            if Value then
                Tokens[#Tokens + 1] = {
                    Type = "string",
                    Value = Value,
                    Long = true
                }

                I = Next
            else
                Tokens[#Tokens + 1] = {
                    Type = "symbol",
                    Value = C
                }

                I += 1
            end

        elseif C:match("[%a_]") then
            local Start = I
            I += 1

            while I <= #Source and Source:sub(I, I):match("[%w_]") do
                I += 1
            end

            Tokens[#Tokens + 1] = {
                Type = "name",
                Value = Source:sub(Start, I - 1)
            }

        elseif C:match("%d") or (C == "." and N:match("%d")) then
            local Start = I
            I += 1

            while I <= #Source do
                local X = Source:sub(I, I)

                if X:match("[%w%.]") or X == "+" or X == "-" then
                    I += 1
                else
                    break
                end
            end

            Tokens[#Tokens + 1] = {
                Type = "number",
                Value = Source:sub(Start, I - 1)
            }

        else
            local Three = Source:sub(I, I + 2)
            local Two = Source:sub(I, I + 1)

            if Three == "..." then
                Tokens[#Tokens + 1] = {
                    Type = "symbol",
                    Value = Three
                }

                I += 3
            elseif Two == "==" or Two == "~=" or Two == "<=" or Two == ">=" or Two == ".." or Two == "//" or Two == "+=" or Two == "-=" or Two == "*=" or Two == "/=" or Two == "%=" or Two == "^=" or Two == "::" then
                Tokens[#Tokens + 1] = {
                    Type = "symbol",
                    Value = Two
                }

                I += 2
            else
                Tokens[#Tokens + 1] = {
                    Type = "symbol",
                    Value = C
                }

                I += 1
            end
        end
    end

    return Tokens
end

local function DecodeString(Value)
    if #Value < 2 then
        return Value
    end

    local Quote = Value:sub(1, 1)

    if Quote ~= "\"" and Quote ~= "'" then
        return nil
    end

    local Body = Value:sub(2, -2)
    local Out = {}
    local I = 1

    while I <= #Body do
        local C = Body:sub(I, I)

        if C ~= "\\" then
            Out[#Out + 1] = C
            I += 1
        else
            local N = Body:sub(I + 1, I + 1)

            if N == "n" then
                Out[#Out + 1] = "\n"
                I += 2
            elseif N == "r" then
                Out[#Out + 1] = "\r"
                I += 2
            elseif N == "t" then
                Out[#Out + 1] = "\t"
                I += 2
            elseif N == "b" then
                Out[#Out + 1] = "\b"
                I += 2
            elseif N == "f" then
                Out[#Out + 1] = "\f"
                I += 2
            elseif N == "v" then
                Out[#Out + 1] = "\v"
                I += 2
            elseif N == "a" then
                Out[#Out + 1] = "\a"
                I += 2
            elseif N == "\\" or N == "\"" or N == "'" then
                Out[#Out + 1] = N
                I += 2
            elseif N:match("%d") then
                local Digits = Body:sub(I + 1, I + 3)
                local Num = Digits:match("^%d%d?%d?")

                if Num then
                    Out[#Out + 1] = string.char(tonumber(Num))
                    I += #Num + 1
                else
                    Out[#Out + 1] = N
                    I += 2
                end
            else
                Out[#Out + 1] = N
                I += 2
            end
        end
    end

    return table.concat(Out)
end

local function EncodeString(Token)
    local Raw

    if Token.Long then
        Raw = Token.Value:match("^%[=*%[(.*)%]=*%]$")

        if Raw == nil then
            return Token.Value
        end
    else
        Raw = DecodeString(Token.Value)

        if Raw == nil then
            return Token.Value
        end
    end

    if #Raw == 0 then
        return "\"\""
    end

    local Parts = {}

    for I = 1, #Raw do
        Parts[#Parts + 1] = tostring(string.byte(Raw, I))
    end

    return "string.char(" .. table.concat(Parts, ",") .. ")"
end

local function ObfuscateNumber(Value)
    local Number = tonumber(Value)

    if not Number or Number ~= Number then
        return Value
    end

    if Number == math.floor(Number) and math.abs(Number) <= 999999 then
        local A = math.random(2, 25)
        local B = Number - A

        if B >= 0 then
            return "(" .. A .. "+" .. B .. ")"
        end

        return "(" .. (A + math.abs(B)) .. "-" .. math.abs(B) .. ")"
    end

    return Value
end

local function IsMemberAccess(Tokens, Index)
    local Previous = Tokens[Index - 1]

    return Previous ~= nil and (Previous.Value == "." or Previous.Value == ":")
end

local function CollectLocals(Tokens)
    local Locals = {}

    for I = 1, #Tokens do
        local Token = Tokens[I]

        if Token.Type == "name" and Token.Value == "local" then
            local Next = Tokens[I + 1]

            if Next and Next.Type == "name" then
                Locals[Next.Value] = true

                local J = I + 2

                while Tokens[J] and Tokens[J].Value == "," do
                    local Name = Tokens[J + 1]

                    if Name and Name.Type == "name" then
                        Locals[Name.Value] = true
                        J += 2
                    else
                        break
                    end
                end
            end
        end
    end

    return Locals
end

local function BuildRenameMap(Tokens, Options)
    local Map = {}

    if not Options.RenameLocals then
        return Map
    end

    local Locals = CollectLocals(Tokens)

    for Name in pairs(Locals) do
        if not Keywords[Name] then
            Map[Name] = RandomName()
        end
    end

    return Map
end

local function BuildBuiltinMap(Tokens, Options)
    local Map = {}

    if not Options.HideBuiltins then
        return Map
    end

    for I = 1, #Tokens do
        local Token = Tokens[I]

        if Token.Type == "name" and not IsMemberAccess(Tokens, I) then
            for _, Builtin in ipairs(Builtins) do
                if Token.Value == Builtin and not Map[Builtin] then
                    Map[Builtin] = RandomName()
                    break
                end
            end
        end
    end

    return Map
end

local function BuildOutput(Tokens, Options)
    local RenameMap = BuildRenameMap(Tokens, Options)
    local BuiltinMap = BuildBuiltinMap(Tokens, Options)
    local Parts = {}

    for _, Builtin in ipairs(Builtins) do
        local Alias = BuiltinMap[Builtin]

        if Alias then
            Parts[#Parts + 1] = "local " .. Alias .. "=" .. Builtin .. ";"
        end
    end

    if Options.InsertJunk then
        Parts[#Parts + 1] = "local " .. RandomName() .. "=0;"
        Parts[#Parts + 1] = "local " .. RandomName() .. "={};"
        Parts[#Parts + 1] = "local " .. RandomName() .. "=true;"
    end

    for I = 1, #Tokens do
        local Token = Tokens[I]

        if Token.Type == "comment" then
            if not Options.StripComments then
                Parts[#Parts + 1] = Token.Value
            end

        elseif Token.Type == "string" then
            if Options.EncodeStrings then
                Parts[#Parts + 1] = EncodeString(Token)
            else
                Parts[#Parts + 1] = Token.Value
            end

        elseif Token.Type == "number" then
            if Options.ObfuscateNums then
                Parts[#Parts + 1] = ObfuscateNumber(Token.Value)
            else
                Parts[#Parts + 1] = Token.Value
            end

        elseif Token.Type == "name" then
            local Value = Token.Value

            if RenameMap[Value] and not Keywords[Value] then
                Value = RenameMap[Value]
            elseif BuiltinMap[Value] and not IsMemberAccess(Tokens, I) then
                Value = BuiltinMap[Value]
            end

            Parts[#Parts + 1] = Value
        else
            Parts[#Parts + 1] = Token.Value
        end
    end

    local Output = table.concat(Parts)

    if Options.Minify then
        Output = Output
            :gsub("%s+", " ")
            :gsub("%s*([%(%){%}%[%],;:+%-%*/%%%^<>=~%.])%s*", "%1")
            :gsub("^%s+", "")
            :gsub("%s+$", "")
    end

    return Output
end

local function Obfuscate(Source, Options)
    table.clear(UsedNames)

    local Tokens = Tokenize(Source)

    return BuildOutput(Tokens, Options)
end

