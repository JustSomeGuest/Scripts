local function UID(Length)
    local Chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local Out = ""

    repeat
        Out ..= Chars:sub(math.random(1, #Chars), math.random(1, #Chars))
    until #Out >= Length

    return Out:sub(1, Length)
end

local function Xor(A, B)
    local Result = 0
    local Bit = 1

    while A > 0 or B > 0 do
        local AA = A % 2
        local BB = B % 2

        if AA ~= BB then
            Result += Bit
        end

        A = math.floor(A / 2)
        B = math.floor(B / 2)
        Bit *= 2
    end

    return Result
end

local function EncodeSource(Source)
    local Key = math.random(31, 223)
    local Bytes = table.create(#Source)

    for I = 1, #Source do
        local Byte = string.byte(Source, I)
        local Mask = (Key + I * 13) % 256
        Bytes[I] = Xor(Byte, Mask)
    end

    return Key, Bytes
end

local function Name()
    local Chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local Result = Chars:sub(math.random(1, 52), math.random(1, 52))

    for _ = 1, math.random(1, 2) do
        Result ..= Chars:sub(math.random(1, 52), math.random(1, 52))
    end

    return Result
end

local function MakeLoader(Source, Options)
    local Key, Bytes = EncodeSource(Source)

    local A = Name()
    local B = Name()
    local C = Name()
    local D = Name()
    local E = Name()
    local F = Name()
    local G = Name()
    local H = Name()
    local I = Name()
    local J = Name()
    local K = Name()
    local L = Name()

    local Data = {}

    for Index, Byte in ipairs(Bytes) do
        Data[Index] = tostring(Byte)
    end

    local Junk = ""

    if Options.Junk then
        local X = Name()
        local Y = Name()
        local Z = Name()

        Junk = table.concat({
            "local ",
            X,
            "=",
            math.random(10000, 99999),
            ";local ",
            Y,
            "={};local ",
            Z,
            "=",
            X,
            "+",
            math.random(100, 999),
            ";"
        })
    end

    local Output = table.concat({
        "return(function()",
        "local ",
        A,
        ",",
        B,
        ",",
        C,
        ",",
        D,
        ",",
        E,
        ",",
        F,
        "=",
        "string,",
        "loadstring,",
        "pcall,",
        "type,",
        "table,",
        "math",
        ";",
        Junk,
        "local ",
        G,
        "={",
        table.concat(Data, ","),
        "};",
        "local ",
        H,
        "=",
        Key,
        ";",
        "local ",
        I,
        "=\"\";",
        "local ",
        J,
        ";",
        "for ",
        J,
        "=1,#",
        G,
        " do ",
        "local ",
        K,
        "=",
        G,
        "[",
        J,
        "];",
        "local ",
        L,
        "=",
        "(",
        K,
        "-(",
        H,
        "+",
        J,
        "*13))%256;",
        I,
        "=",
        I,
        "..",
        A,
        ".char(",
        L,
        ");",
        "end;",
        "local ",
        J,
        "=",
        B,
        "(",
        I,
        ");",
        "if ",
        E,
        "(",
        J,
        ")~=\"function\" then return end;",
        "return ",
        J,
        "()",
        "end)()"
    })

    return Output
end

local function Obfuscate(Source, Options)
    if Source == "" then
        return ""
    end

    return MakeLoader(Source, Options)
end

