local UsedNames = {}

local function RandomName()
    local Name

    repeat
        Name = UID(math.random(3, 7))
    until not Keywords[Name] and not UsedNames[Name]

    UsedNames[Name] = true
    return Name
end

local function ReadString(Source, Start)
    local Quote = Source:sub(Start, Start)
    local I = Start + 1
    local Escaped = false

    while I <= #Source do
        local C = Source:sub(I, I)

        if Escaped then
            Escaped = false
        elseif C == "\\" then
            Escaped = true
        elseif C == Quote then
            return Source:sub(Start, I), I + 1
        end

        I += 1
    end

    return Source:sub(Start), #Source + 1
end

local function ReadLongString(Source, Start)
    local Eq = 0
    local I = Start + 1

    while Source:sub(I, I) == "=" do
        Eq += 1
        I += 1
    end

    if Source:sub(I, I) ~= "[" then
        return nil
    end

    local Close = "]" .. string.rep("=", Eq) .. "]"
    local End = Source:find(Close, I + 1, true)

    if not End then
        return Source:sub(Start), #Source + 1
    end

    return Source:sub(Start, End + #Close - 1), End + #Close
end

local function Tokenize(Source)
    local Tokens = {}
    local I = 1

    while I <= #Source do
        local C = Source:sub(I, I)
        local N = Source:sub(I + 1, I + 1)

        if C:match("%s") then
            I += 1

        elseif C == "-" and N == "-" then
            local Long = Source:sub(I + 2, I + 2) == "["

            if Long then
                local Value, Next = ReadLongString(Source, I + 2)

                if Value then
                    table.insert(Tokens, {
                        Type = "comment",
                        Value = "--" .. Value
                    })
                    I = Next
                else
                    local E = Source:find("\n", I + 2, true) or (#Source + 1)
                    table.insert(Tokens, {
                        Type = "comment",
                        Value = Source:sub(I, E - 1)
                    })
                    I = E
                end
            else
                local E = Source:find("\n", I + 2, true) or (#Source + 1)
                table.insert(Tokens, {
                    Type = "comment",
                    Value = Source:sub(I, E - 1)
                })
                I = E
            end

        elseif C == "\"" or C == "'" then
            local Value, Next = ReadString(Source, I)

            table.insert(Tokens, {
                Type = "string",
                Value = Value
            })

            I = Next

        elseif C == "[" then
            local Value, Next = ReadLongString(Source, I)

            if Value then
                table.insert(Tokens, {
                    Type = "string",
                    Value = Value,
                    Long = true
                })
                I = Next
            else
                table.insert(Tokens, {
                    Type = "symbol",
                    Value = C
                })
                I += 1
            end

        elseif C:match("[%a_]") then
            local Start = I
            I += 1

            while I <= #Source and Source:sub(I, I):match("[%w_]") do
                I += 1
            end

            local Value = Source:sub(Start, I - 1)

            table.insert(Tokens, {
                Type = "name",
                Value = Value
            })

        elseif C:match("%d") or (C == "." and N:match("%d")) then
            local Start = I
            I += 1

            while I <= #Source do
                local X = Source:sub(I, I)

                if X:match("[%w%.]") or X == "+" or X == "-" then
                    I += 1
                else
                    break
                end
            end

            table.insert(Tokens, {
                Type = "number",
                Value = Source:sub(Start, I - 1)
            })

        else
            local Three = Source:sub(I, I + 2)
            local Two = Source:sub(I, I + 1)

            if Three == "..." then
                table.insert(Tokens, {
                    Type = "symbol",
                    Value = Three
                })
                I += 3
            elseif Two == "==" or Two == "~=" or Two == "<=" or Two == ">=" or Two == ".." or Two == "//" or Two == "+=" or Two == "-=" or Two == "*=" or Two == "/=" or Two == "%=" or Two == "^=" or Two == "::" then
                table.insert(Tokens, {
                    Type = "symbol",
                    Value = Two
                })
                I += 2
            else
                table.insert(Tokens, {
                    Type = "symbol",
                    Value = C
                })
                I += 1
            end
        end
    end

    return Tokens
end

local function DecodeQuoted(Value)
    if #Value < 2 then
        return Value
    end

    local Quote = Value:sub(1, 1)

    if Quote ~= "\"" and Quote ~= "'" then
        return nil
    end

    local Body = Value:sub(2, -2)
    local Out = {}
    local I = 1

    while I <= #Body do
        local C = Body:sub(I, I)

        if C ~= "\\" then
            table.insert(Out, C)
            I += 1
            continue
        end

        local N = Body:sub(I + 1, I + 1)

        if N == "n" then
            table.insert(Out, "\n")
            I += 2
        elseif N == "r" then
            table.insert(Out, "\r")
            I += 2
        elseif N == "t" then
            table.insert(Out, "\t")
            I += 2
        elseif N == "b" then
            table.insert(Out, "\b")
            I += 2
        elseif N == "f" then
            table.insert(Out, "\f")
            I += 2
        elseif N == "v" then
            table.insert(Out, "\v")
            I += 2
        elseif N == "a" then
            table.insert(Out, "\a")
            I += 2
        elseif N == "\\" or N == "\"" or N == "'" then
            table.insert(Out, N)
            I += 2
        elseif N:match("%d") then
            local Digits = Body:sub(I + 1, I + 3)
            local Num = Digits:match("^%d%d?%d?")

            if Num then
                table.insert(Out, string.char(tonumber(Num)))
                I += #Num + 1
            else
                table.insert(Out, N)
                I += 2
            end
        else
            table.insert(Out, N)
            I += 2
        end
    end

    return table.concat(Out)
end

local function EncodeString(Value)
    local Raw

    if Value.Long then
        Raw = Value.Value:match("^%[=*%[(.*)%]=*%]$")
        if Raw == nil then
            return Value.Value
        end
    else
        Raw = DecodeQuoted(Value.Value)
        if Raw == nil then
            return Value.Value
        end
    end

    local Parts = {}

    for I = 1, #Raw do
        Parts[#Parts + 1] = tostring(string.byte(Raw, I))
    end

    if #Parts == 0 then
        return "\"\""
    end

    return "string.char(" .. table.concat(Parts, ",") .. ")"
end

local function ObfuscateNumber(Value)
    local Number = tonumber(Value)

    if not Number or Number ~= Number then
        return Value
    end

    if Number == math.floor(Number) and math.abs(Number) <= 999999 then
        local A = math.random(2, 25)
        local B = Number - A

        if B >= 0 then
            return "(" .. A .. "+" .. B .. ")"
        end

        return "(" .. (A + math.abs(B)) .. "-" .. math.abs(B) .. ")"
    end

    return Value
end

local function IsMemberAccess(Tokens, Index)
    local Previous = Tokens[Index - 1]

    if not Previous then
        return false
    end

    return Previous.Value == "." or Previous.Value == ":"
end

local function CollectLocals(Tokens)
    local Locals = {}

    for I, Token in ipairs(Tokens) do
        if Token.Type == "name" and Token.Value == "local" then
            local Next = Tokens[I + 1]

            if Next and Next.Type == "name" then
                Locals[Next.Value] = true

                local J = I + 2

                while Tokens[J] and Tokens[J].Value == "," do
                    if Tokens[J + 1] and Tokens[J + 1].Type == "name" then
                        Locals[Tokens[J + 1].Value] = true
                        J += 2
                    else
                        break
                    end
                end
            end
        elseif Token.Type == "name" and Token.Value == "function" then
            local Name = Tokens[I + 1]

            if Name and Name.Type == "name" and not IsMemberAccess(Tokens, I + 1) then
                Locals[Name.Value] = true
            end
        end
    end

    return Locals
end

local function BuildRenameMap(Tokens, Options)
    local Map = {}

    if not Options.RenameLocals then
        return Map
    end

    local Locals = CollectLocals(Tokens)

    for Name in pairs(Locals) do
        if not Keywords[Name] then
            Map[Name] = RandomName()
        end
    end

    return Map
end

local function BuildBuiltinMap(Tokens)
    local Map = {}
    local Seen = {}

    for _, Token in ipairs(Tokens) do
        if Token.Type == "name" and not IsMemberAccess(Tokens, table.find(Tokens, Token)) then
            for _, Builtin in ipairs(Builtins) do
                if Token.Value == Builtin and not Seen[Builtin] then
                    Map[Builtin] = RandomName()
                    Seen[Builtin] = true
                    break
                end
            end
        end
    end

    return Map
end

local function ApplyBuiltinMap(Tokens)
    local Map = {}
    local Seen = {}

    for I, Token in ipairs(Tokens) do
        if Token.Type == "name" and not IsMemberAccess(Tokens, I) then
            for _, Builtin in ipairs(Builtins) do
                if Token.Value == Builtin and not Seen[Builtin] then
                    Map[Builtin] = RandomName()
                    Seen[Builtin] = true
                    break
                end
            end
        end
    end

    for I, Token in ipairs(Tokens) do
        if Token.Type == "name" and Map[Token.Value] and not IsMemberAccess(Tokens, I) then
            Token.Value = Map[Token.Value]
        end
    end

    return Map
end

local function BuildOutput(Tokens, Options)
    local RenameMap = BuildRenameMap(Tokens, Options)
    local BuiltinMap = {}

    if Options.HideBuiltins then
        BuiltinMap = ApplyBuiltinMap(Tokens)
    end

    local Parts = {}

    if Options.HideBuiltins and next(BuiltinMap) then
        for Builtin, Alias in pairs(BuiltinMap) do
            Parts[#Parts + 1] = "local " .. Alias .. "=" .. Builtin .. ";"
        end
    end

    for I, Token in ipairs(Tokens) do
        if Token.Type == "comment" then
            if not Options.StripComments then
                Parts[#Parts + 1] = Token.Value
            end

        elseif Token.Type == "string" then
            if Options.EncodeStrings then
                Parts[#Parts + 1] = EncodeString(Token)
            else
                Parts[#Parts + 1] = Token.Value
            end

        elseif Token.Type == "number" then
            if Options.ObfuscateNums then
                Parts[#Parts + 1] = ObfuscateNumber(Token.Value)
            else
                Parts[#Parts + 1] = Token.Value
            end

        elseif Token.Type == "name" then
            local Value = Token.Value

            if RenameMap[Value] and not Keywords[Value] then
                Value = RenameMap[Value]
            end

            if BuiltinMap[Value] and not IsMemberAccess(Tokens, I) then
                Value = BuiltinMap[Value]
            end

            Parts[#Parts + 1] = Value

        else
            Parts[#Parts + 1] = Token.Value
        end
    end

    local Output = table.concat(Parts)

    if Options.InsertJunk then
        local Junk = {
            "local " .. RandomName() .. "=0;",
            "local " .. RandomName() .. "={};",
            "local " .. RandomName() .. "=true;",
        }

        Output = table.concat(Junk) .. Output
    end

    if Options.Minify then
        Output = Output
            :gsub("%s+", " ")
            :gsub("%s*([%(%){%}%[%],;:+%-%*/%%%^<>=~%.])%s*", "%1")
            :gsub(";%s*end", ";end")
            :gsub("^%s+", "")
            :gsub("%s+$", "")
    end

    return Output
end

local function Obfuscate(Source, Options)
    table.clear(UsedNames)

    local Tokens = Tokenize(Source)

    return BuildOutput(Tokens, Options)
end

