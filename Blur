local function UID(Length)
    local Chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local Out = ""

    for _ = 1, Length do
        local N = math.random(1, #Chars)
        Out ..= Chars:sub(N, N)
    end

    return Out
end

local function Shuffle(Table)
    for I = #Table, 2, -1 do
        local J = math.random(1, I)
        Table[I], Table[J] = Table[J], Table[I]
    end

    return Table
end

local function Xor(A, B)
    local Result = 0
    local Bit = 1

    while A > 0 or B > 0 do
        local AA = A % 2
        local BB = B % 2

        if AA ~= BB then
            Result += Bit
        end

        A = math.floor(A / 2)
        B = math.floor(B / 2)
        Bit *= 2
    end

    return Result
end

local function Encode(Source)
    local Key = math.random(17, 241)
    local Bytes = table.create(#Source)

    for I = 1, #Source do
        local Byte = string.byte(Source, I)
        local K = (Key + I * 13) % 256
        Bytes[I] = string.char(Xor(Byte, K))
    end

    return Key, table.concat(Bytes)
end

local function EscapeString(Source)
    Source = Source:gsub("\\", "\\\\")
    Source = Source:gsub("\"", "\\\"")
    Source = Source:gsub("\n", "\\n")
    Source = Source:gsub("\r", "\\r")
    Source = Source:gsub("\t", "\\t")

    return Source
end

local function EncodePayload(Source)
    local Key, Payload = Encode(Source)
    local Parts = {}

    for I = 1, #Payload do
        Parts[#Parts + 1] = tostring(string.byte(Payload, I))
