    Status.Text = "Ready"
end)

Action.MouseButton1Click:Connect(function()
    if Output.Visible then
        if type(setclipboard) == "function" then
            setclipboard(Output.Text)
            Status.Text = "Copied"
        else
            Status.Text = "Output ready"
        end

        return
    end

    local Source = Editor.Text

    if Source == "" then
        Status.Text = "Nothing to obfuscate"
        return
    end

    Status.Text = "Obfuscating..."
    Action.Active = false

    task.wait()

    local Success, Result = pcall(MakeLoader, Source)

    Action.Active = true

    if not Success or type(Result) ~= "string" or Result == "" then
        Status.Text = "Obfuscation failed"
        return
    end

    Output.Text = Result
    Editor.Visible = false
    Output.Visible = true
    Back.Visible = true
    Action.Text = "Copy Output"
    Status.Text = "Obfuscated"
end)

