local function GetJunkLine(Names)
    local T = JunkTemplates[math.random(1, #JunkTemplates)]
    return T(Names)
end

local function Obfuscate(Source, Options)
    Options = Options or {}
    local RenameLocals  = Options.RenameLocals  ~= false
    local EncodeStrings = Options.EncodeStrings ~= false
    local ObfuscateNums = Options.ObfuscateNums ~= false
    local InsertJunk    = Options.InsertJunk    ~= false
    local StripComments = Options.StripComments ~= false
    local Minify        = Options.Minify        == true

    local Ok, Tokens = pcall(Tokenize, Source)
    if not Ok then
        return nil, "Tokenizer error: " .. tostring(Tokens)
    end

    local Names = ObfuscatorUsed()

    local LocalSet = {}
    if RenameLocals then
        LocalSet = CollectLocals(Tokens)
    end

    local RenameMap = {}
    if RenameLocals then
        RenameMap = BuildRenameMap(Tokens, LocalSet, Names)
    end

    local InStringContext = {}
    for I, Tok in ipairs(Tokens) do
        if Tok.Type == TokenType.String or Tok.Type == TokenType.LongString then
            InStringContext[I] = true
        end
    end

    local Output = {}
    local PrevWasAlnum = false
    local LineCount = 0
    local JunkEvery = math.random(4, 8)
    local LinesSinceJunk = 0

    for I, Tok in ipairs(Tokens) do
        if Tok.Type == TokenType.Eof then
            break
        end

        if Tok.Type == TokenType.Comment then
            if not StripComments then
                Output[#Output + 1] = Tok.Value
            end

        elseif Tok.Type == TokenType.LongString then
            Output[#Output + 1] = Tok.Value

        elseif Tok.Type == TokenType.String then
            if EncodeStrings then
                local Quote = Tok.Value:sub(1, 1)
                if Quote == '"' or Quote == "'" then
                    Output[#Output + 1] = EncodeString(Tok.Value)
                else
                    Output[#Output + 1] = Tok.Value
                end
            else
                Output[#Output + 1] = Tok.Value
            end

        elseif Tok.Type == TokenType.Number then
            if ObfuscateNums and not Tok.Value:match("[xXbBoO]") and not Tok.Value:match("[eE]") and not Tok.Value:match("%.") then
                Output[#Output + 1] = ObfuscateNumber(Tok.Value)
            else
                Output[#Output + 1] = Tok.Value
            end

        elseif Tok.Type == TokenType.Name then
            local Val = Tok.Value
            if RenameLocals and RenameMap[Val] and not IsAfterDot(Tokens, I) then
                Val = RenameMap[Val]
            end
            if PrevWasAlnum then
                Output[#Output + 1] = " "
            end
            Output[#Output + 1] = Val
            PrevWasAlnum = true

        elseif Tok.Type == TokenType.Keyword then
            if PrevWasAlnum then
                Output[#Output + 1] = " "
            end
            Output[#Output + 1] = Tok.Value
            PrevWasAlnum = true

        elseif Tok.Type == TokenType.Space then
            if Minify then
                PrevWasAlnum = false
            else
                Output[#Output + 1] = Tok.Value
                PrevWasAlnum = false
            end

        elseif Tok.Type == TokenType.Newline then
            LineCount = LineCount + 1
            LinesSinceJunk = LinesSinceJunk + 1

            if Minify then
                Output[#Output + 1] = ";"
                PrevWasAlnum = false
            else
                if InsertJunk and LinesSinceJunk >= JunkEvery and math.random(0, 2) ~= 0 then
                    local JunkCount = math.random(1, 2)
                    for _ = 1, JunkCount do
                        Output[#Output + 1] = "\n" .. GetJunkLine(Names)
                    end
                    LinesSinceJunk = 0
                    JunkEvery = math.random(4, 9)
                end
                Output[#Output + 1] = "\n"
                PrevWasAlnum = false
            end

        else
            local Val = Tok.Value
            local IsAlnum = Val:match("[%w_]")
            if IsAlnum and PrevWasAlnum then
                Output[#Output + 1] = " "
            end
            Output[#Output + 1] = Val
            PrevWasAlnum = IsAlnum ~= nil
        end
    end

    local Result = table.concat(Output)

    if InsertJunk and not Minify then
        local HeaderLines = {}
        local JunkCountHeader = math.random(3, 6)
        for _ = 1, JunkCountHeader do
            HeaderLines[#HeaderLines + 1] = GetJunkLine(Names)
        end
        Result = table.concat(HeaderLines, "\n") .. "\n" .. Result
    end

    return Result, nil
end

