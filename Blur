local function Encode(Source, Key)
    local Data = table.create(#Source)

    for I = 1, #Source do
        Data[I] = (string.byte(Source, I) + Key + I * 13) % 256
    end

    return Data
end

local function MakeLoader(Source)
    local A = UID(math.random(2, 4))
    local B = UID(math.random(2, 4))
    local C = UID(math.random(2, 4))
    local D = UID(math.random(2, 4))
    local E = UID(math.random(2, 4))
    local F = UID(math.random(2, 4))
    local G = UID(math.random(2, 4))
    local H = UID(math.random(2, 4))

    local Key = math.random(10000, 99999)
    local Data = Encode(Source, Key)

    return table.concat({
        "return({function()",
        "local ", A, ",", B, ",", C, ",", D, "=string,loadstring,pcall,type",
        ";local ", E, "=", Key,
        ";local ", F, "={", table.concat(Data, ","), "}",
        ";local ", G, "=\"\"",
        ";local ", H, "=1",
        ";while ", H, "<=#", F, " do ",
        G, "=", G, "..", A, ".char((",
        F, "[", H, "]-", E, "-", H, "*13)%256)",
        ";", H, "=", H, "+1 end",
        ";local ", A, "=", B, "(", G, ")",
        ";if ", D, "(", A, ')=="function" then return ', A, "() end",
        "end})[1]()"
    })
end

