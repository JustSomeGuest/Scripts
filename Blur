local function RandomName(Length)
    Length = Length or math.random(3, 8)

    local Chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local Name = table.create(Length)

    for i = 1, Length do
        local Index = math.random(1, #Chars)
        Name[i] = Chars:sub(Index, Index)
    end

    return table.concat(Name)
end

local function ObfuscatorUsed()
    local Used = {}

    return {
        New = function(self, Base)
            local Name

            repeat
                Name = (Base or "") .. RandomName(math.random(3, 8))
            until not Used[Name]
                and not LuauKeywords[Name]
                and not LuauBuiltinsSet[Name]

            Used[Name] = true

            return Name
        end
    }
end

local TokenType = {
    Name = "Name",
    String = "String",
    Number = "Number",
    Op = "Op",
    Punct = "Punct",
    Keyword = "Keyword",
    Newline = "Newline",
    Space = "Space",
    Comment = "Comment",
    LongString = "LongString",
    Eof = "Eof"
}

local function Tokenize(Source)
    local Tokens = {}
    local Pos = 1
    local Len = #Source

    local function Peek(Offset)
        Offset = Offset or 0
        return Source:sub(Pos + Offset, Pos + Offset)
    end

    local function Advance(Count)
        Count = Count or 1

        local Value = Source:sub(Pos, Pos + Count - 1)

        Pos = Pos + Count

        return Value
    end

    local function ReadLongBracket()
        if Peek() ~= "[" then
            return nil
        end

        local Start = Pos
        local I = Pos + 1
        local Level = 0

        while Source:sub(I, I) == "=" do
            Level = Level + 1
            I = I + 1
        end

        if Source:sub(I, I) ~= "[" then
            return nil
        end

        local OpenLength = Level + 2
        local Close = "]" .. string.rep("=", Level) .. "]"

        Pos = Pos + OpenLength

        local ClosePosition = Source:find(Close, Pos, true)

        if not ClosePosition then
            local Value = Source:sub(Start)

            Pos = Len + 1

            return Value
        end

        local Value = Source:sub(Start, ClosePosition + #Close - 1)

        Pos = ClosePosition + #Close

        return Value
    end

    while Pos <= Len do
        local Ch = Peek()

        if Ch == "\n" then
            Advance()

            Tokens[#Tokens + 1] = {
                Type = TokenType.Newline,
                Value = "\n"
            }

        elseif Ch == " "
            or Ch == "\t"
            or Ch == "\r" then

            local Start = Pos

            while Pos <= Len do
                local Current = Peek()

                if Current ~= " "
                    and Current ~= "\t"
                    and Current ~= "\r" then
                    break
                end

                Advance()
            end

            Tokens[#Tokens + 1] = {
                Type = TokenType.Space,
                Value = Source:sub(Start, Pos - 1)
            }

        elseif Ch == "-" and Peek(1) == "-" then
            Advance(2)

            local Long = ReadLongBracket()

            if Long then
                Tokens[#Tokens + 1] = {
                    Type = TokenType.Comment,
                    Value = "--" .. Long
                }
            else
                local Start = Pos

                while Pos <= Len and Peek() ~= "\n" do
                    Advance()
                end

                Tokens[#Tokens + 1] = {
                    Type = TokenType.Comment,
                    Value = "--" .. Source:sub(Start, Pos - 1)
                }
            end

        elseif Ch == "[" then
            local Save = Pos
            local Long = ReadLongBracket()

            if Long then
                Tokens[#Tokens + 1] = {
                    Type = TokenType.LongString,
                    Value = Long
                }
            else
                Pos = Save
                Advance()

                Tokens[#Tokens + 1] = {
                    Type = TokenType.Punct,
                    Value = "["
                }
            end

        elseif Ch == '"' or Ch == "'" then
            local Quote = Advance()
            local Parts = {Quote}

            while Pos <= Len do
                local Current = Peek()

                if Current == "\\" then
                    Parts[#Parts + 1] = Advance()

                    if Pos <= Len then
                        Parts[#Parts + 1] = Advance()
                    end
                elseif Current == Quote then
                    Parts[#Parts + 1] = Advance()
                    break
                elseif Current == "\n" then
                    break
                else
                    Parts[#Parts + 1] = Advance()
                end
            end

            Tokens[#Tokens + 1] = {
                Type = TokenType.String,
                Value = table.concat(Parts)
            }

        elseif Ch:match("%d")
            or (Ch == "." and Peek(1):match("%d")) then

            local Start = Pos

            if Ch == "0"
                and (Peek(1) == "x" or Peek(1) == "X") then

                Advance(2)

                while Pos <= Len
                    and Peek():match("[%da-fA-F_]") do
                    Advance()
                end

            elseif Ch == "0"
                and (Peek(1) == "b" or Peek(1) == "B") then

                Advance(2)

                while Pos <= Len
                    and Peek():match("[01_]") do
                    Advance()
                end

            else
                while Pos <= Len
                    and Peek():match("[%d_]") do
                    Advance()
                end

                if Peek() == "."
                    and Peek(1):match("%d") then

                    Advance()

                    while Pos <= Len
                        and Peek():match("[%d_]") do
                        Advance()
                    end
                end

                if Peek() == "e"
                    or Peek() == "E" then

                    Advance()

                    if Peek() == "+"
                        or Peek() == "-" then
                        Advance()
                    end

                    while Pos <= Len
                        and Peek():match("[%d_]") do
                        Advance()
                    end
                end
            end

            Tokens[#Tokens + 1] = {
                Type = TokenType.Number,
                Value = Source:sub(Start, Pos - 1)
            }

        elseif Ch:match("[%a_]") then
            local Start = Pos

            while Pos <= Len
                and Peek():match("[%w_]") do
                Advance()
            end

            local Word = Source:sub(Start, Pos - 1)

            Tokens[#Tokens + 1] = {
                Type = LuauKeywords[Word]
                    and TokenType.Keyword
                    or TokenType.Name,
                Value = Word
            }

        else
            local Three = Ch .. Peek(1) .. Peek(2)
            local Two = Ch .. Peek(1)

            if Three == "..." then
                Advance(3)

                Tokens[#Tokens + 1] = {
                    Type = TokenType.Op,
                    Value = "..."
                }

            elseif Two == ".."
                or Two == "=="
                or Two == "~="
                or Two == "<="
                or Two == ">="
                or Two == "<<"
                or Two == ">>"
                or Two == "//"
                or Two == "+="
                or Two == "-="
                or Two == "*="
                or Two == "/="
                or Two == "%="
                or Two == "^="
                or Two == "&="
                or Two == "|="
                or Two == "::" then

                Advance(2)

                Tokens[#Tokens + 1] = {
                    Type = TokenType.Op,
                    Value = Two
                }

            else
                Advance()

                Tokens[#Tokens + 1] = {
                    Type = TokenType.Punct,
                    Value = Ch
                }
            end
        end
    end

    Tokens[#Tokens + 1] = {
        Type = TokenType.Eof,
        Value = ""
    }

    return Tokens
end

local function CollectLocals(Tokens)
    local Locals = {}
    local I = 1

    while I <= #Tokens do
        local Tok = Tokens[I]

        if Tok.Type == TokenType.Keyword
            and Tok.Value == "local" then

            local J = I + 1

            while J <= #Tokens
                and (
                    Tokens[J].Type == TokenType.Space
                    or Tokens[J].Type == TokenType.Newline
                ) do
                J = J + 1
            end

            if Tokens[J]
                and Tokens[J].Type == TokenType.Keyword
                and Tokens[J].Value == "function" then

                J = J + 1

                while J <= #Tokens
                    and (
                        Tokens[J].Type == TokenType.Space
                        or Tokens[J].Type == TokenType.Newline
                    ) do
                    J = J + 1
                end

                if Tokens[J]
                    and Tokens[J].Type == TokenType.Name then

                    Locals[Tokens[J].Value] = true
                end
            else
                while J <= #Tokens do
                    local Current = Tokens[J]

                    if Current.Type == TokenType.Name then
                        Locals[Current.Value] = true
                    elseif Current.Type == TokenType.Punct
                        and Current.Value == "," then
                    elseif Current.Type == TokenType.Space
                        or Current.Type == TokenType.Newline then
                    else
                        break
                    end

                    J = J + 1
                end
            end
        end

        I = I + 1
    end

    return Locals
end

local function IsMemberAccess(Tokens, Index)
    local I = Index - 1

    while I >= 1
        and (
            Tokens[I].Type == TokenType.Space
            or Tokens[I].Type == TokenType.Newline
        ) do
        I = I - 1
    end

    if not Tokens[I] then
        return false
    end

    return Tokens[I].Value == "."
        or Tokens[I].Value == ":"
end

local function BuildRenameMap(Tokens, LocalSet, Names)
    local Map = {}

    for Name in pairs(LocalSet) do
        if not LuauKeywords[Name]
            and not LuauBuiltinsSet[Name] then

            Map[Name] = Names:New()
        end
    end

    return Map
end

local function DecodeStringValue(Value)
    local Inner = Value:sub(2, -2)
    local Result = {}
    local I = 1

    while I <= #Inner do
        local Ch = Inner:sub(I, I)

        if Ch == "\\" then
            local Next = Inner:sub(I + 1, I + 1)

            if Next == "x"
                and Inner:sub(I + 2, I + 3):match("^[%da-fA-F][%da-fA-F]$") then

                local Hex = Inner:sub(I + 2, I + 3)
                Result[#Result + 1] = string.char(tonumber(Hex, 16))
                I = I + 4

            elseif Next == "n" then
                Result[#Result + 1] = "\n"
                I = I + 2

            elseif Next == "r" then
                Result[#Result + 1] = "\r"
                I = I + 2

            elseif Next == "t" then
                Result[#Result + 1] = "\t"
                I = I + 2

            elseif Next == "a" then
                Result[#Result + 1] = "\a"
                I = I + 2

            elseif Next == "b" then
                Result[#Result + 1] = "\b"
                I = I + 2

            elseif Next == "f" then
                Result[#Result + 1] = "\f"
                I = I + 2

            elseif Next == "v" then
                Result[#Result + 1] = "\v"
                I = I + 2

            elseif Next == "\\" then
                Result[#Result + 1] = "\\"
                I = I + 2

            elseif Next == '"' then
                Result[#Result + 1] = '"'
                I = I + 2

            elseif Next == "'" then
                Result[#Result + 1] = "'"
                I = I + 2

            else
                Result[#Result + 1] = Ch
                I = I + 1
            end
        else
            Result[#Result + 1] = Ch
            I = I + 1
        end
    end

    return table.concat(Result)
end

local function EncodeString(Value)
    local Quote = Value:sub(1, 1)

    if Value:sub(-1) ~= Quote then
        return Value
    end

    local Decoded = DecodeStringValue(Value)
    local Parts = table.create(#Decoded)

    for I = 1, #Decoded do
        Parts[I] = string.format("\\x%02X", Decoded:byte(I))
    end

    return Quote .. table.concat(Parts) .. Quote
end

local function ObfuscateNumber(Value)
    local Number = tonumber(Value)

    if not Number
        or Number ~= math.floor(Number)
        or Number < 0
        or Number > 1000000 then

        return Value
    end

    local Mode = math.random(1, 4)

    if Mode == 1 then
        local A = math.random(1, 255)
        local B = Number - A

        if B >= 0 then
            return "(" .. tostring(A) .. "+" .. tostring(B) .. ")"
        end

    elseif Mode == 2 then
        return "0x" .. string.format("%X", Number)

    elseif Mode == 3
        and Number <= 65535 then

        local Binary = {}

        if Number == 0 then
            return "0b0"
        end

        local N = Number

        while N > 0 do
            Binary[#Binary + 1] = tostring(N % 2)
            N = math.floor(N / 2)
        end

        for I = 1, math.floor(#Binary / 2) do
            Binary[I], Binary[#Binary - I + 1] =
                Binary[#Binary - I + 1], Binary[I]
        end

        return "0b" .. table.concat(Binary)

    elseif Mode == 4 then
        local A = math.random(2, 20)
        local B = math.floor(Number / A)
        local C = Number - A * B

        if B >= 0 and C >= 0 then
            return "("
                .. tostring(A)
                .. "*"
                .. tostring(B)
                .. "+"
                .. tostring(C)
                .. ")"
        end
    end

    return Value
end

local JunkTemplates = {
    function(Names)
        local A = Names:New("_")
        return "local " .. A .. "=" .. tostring(math.random(10, 9999))
    end,

    function(Names)
        local A = Names:New("_")
        return "local " .. A .. "=type(nil)"
    end,

    function(Names)
        local A = Names:New("_")
        return "local " .. A .. "={}"
    end,

    function(Names)
        local A = Names:New("_")
        local B = math.random(1, 20)
        return "local " .. A .. "=" .. tostring(B) .. "*" .. tostring(B)
    end,

    function(Names)
        local A = Names:New("_")
        return "local " .. A .. "=string.char(" .. tostring(math.random(65, 90)) .. ")"
    end
}

local function GetJunk(Names)
    return JunkTemplates[math.random(1, #JunkTemplates)](Names)
end

local function IsWordLike(Token)
    if not Token then
        return false
    end

    if Token.Type == TokenType.Name
        or Token.Type == TokenType.Keyword
        or Token.Type == TokenType.Number then
        return true
    end

    return false
end

local function NeedSeparator(Previous, Current)
    if not Previous
        or not Current then
        return false
    end

    if IsWordLike(Previous)
        and IsWordLike(Current) then
        return true
    end

    if Previous.Type == TokenType.Op
        and Current.Type == TokenType.Op then
        return true
    end

    if Previous.Value == "-"
        and Current.Value == "-" then
        return true
    end

    return false
end

local function BuildCompact(Tokens, RenameMap, Options, Names)
    local Output = {}
    local Previous = nil
    local JunkCounter = 0
    local JunkEvery = math.random(7, 14)

    for Index, Token in ipairs(Tokens) do
        if Token.Type == TokenType.Eof then
            break
        end

        if Token.Type == TokenType.Comment then
            if not Options.StripComments then
                Output[#Output + 1] = Token.Value
                Previous = Token
            end

        elseif Token.Type == TokenType.Space
            or Token.Type == TokenType.Newline then

            if not Options.Minify then
                Output[#Output + 1] = " "
            end

        elseif Token.Type == TokenType.LongString then
            Output[#Output + 1] = Token.Value
            Previous = Token

        elseif Token.Type == TokenType.String then
            if Options.EncodeStrings then
                Token.Value = EncodeString(Token.Value)
            end

            if NeedSeparator(Previous, Token) then
                Output[#Output + 1] = " "
            end

            Output[#Output + 1] = Token.Value
            Previous = Token

        elseif Token.Type == TokenType.Number then
            local Value = Token.Value

            if Options.ObfuscateNums then
                Value = ObfuscateNumber(Value)
            end

            if NeedSeparator(Previous, Token) then
                Output[#Output + 1] = " "
            end

            Output[#Output + 1] = Value
            Previous = {
                Type = TokenType.Number,
                Value = Value
            }

        elseif Token.Type == TokenType.Name then
            local Value = Token.Value

            if Options.RenameLocals
                and RenameMap[Value]
                and not IsMemberAccess(Tokens, Index) then

                Value = RenameMap[Value]
            end

            if NeedSeparator(Previous, Token) then
                Output[#Output + 1] = " "
            end

            Output[#Output + 1] = Value

            Previous = {
                Type = TokenType.Name,
                Value = Value
            }

        else
            local Value = Token.Value

            if NeedSeparator(Previous, Token) then
                Output[#Output + 1] = " "
            end

            Output[#Output + 1] = Value

            Previous = {
                Type = Token.Type,
                Value = Value
            }
        end

        if Options.InsertJunk
            and not Options.Minify
            and Token.Type == TokenType.Newline then

            JunkCounter = JunkCounter + 1

            if JunkCounter >= JunkEvery then
                Output[#Output + 1] = GetJunk(Names)
                JunkCounter = 0
                JunkEvery = math.random(7, 14)
            end
        end
    end

    return table.concat(Output)
end

local function NormalizeOneLine(Source)
    Source = Source:gsub("%s+", " ")

    Source = Source:gsub("%s*([%(%)%{%}%[%],;:%?])%s*", "%1")
    Source = Source:gsub("%s*([%.])%s*", "%1")

    Source = Source:gsub("%s*([+%*/%^%%<>~&|])%s*", "%1")
    Source = Source:gsub("%s*=%s*", "=")

    Source = Source:gsub("%s+", " ")

    return Source:match("^%s*(.-)%s*$")
end

local function Obfuscate(Source, Options)
    Options = Options or {}

    local RenameLocals = Options.RenameLocals ~= false
    local EncodeStrings = Options.EncodeStrings ~= false
    local ObfuscateNums = Options.ObfuscateNums ~= false
    local InsertJunk = Options.InsertJunk == true
    local StripComments = Options.StripComments ~= false
    local Minify = Options.Minify ~= false

    local Success, Tokens = pcall(Tokenize, Source)

    if not Success then
        return nil, "Tokenizer error: " .. tostring(Tokens)
    end

    local Names = ObfuscatorUsed()
    local LocalSet = CollectLocals(Tokens)
    local RenameMap = {}

    if RenameLocals then
        RenameMap = BuildRenameMap(Tokens, LocalSet, Names)
    end

    local Result = BuildCompact(
        Tokens,
        RenameMap,
        {
            RenameLocals = RenameLocals,
            EncodeStrings = EncodeStrings,
            ObfuscateNums = ObfuscateNums,
            InsertJunk = InsertJunk,
            StripComments = StripComments,
            Minify = Minify
        },
        Names
    )

    Result = NormalizeOneLine(Result)

    local WrapperName = Names:New()
    local ReturnName = Names:New()

    if Result == "" then
        return nil, "No valid source."
    end

    local Wrapped =
        "return(function()"
        .. "local "
        .. WrapperName
        .. "="
        .. ReturnName
        .. ";"
        .. Result
        .. ";"
        .. "end)()"

    Wrapped = Wrapped:gsub(";;+", ";")

    return Wrapped, nil
end

