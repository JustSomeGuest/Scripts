    Button.BackgroundColor3 = Default and Colors.Accent or Colors.Surface3
    Button.BorderSizePixel = 0
    Button.Text = ""
    Button.AutoButtonColor = false
    Button.Parent = Holder

    Corner(Button, 20)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 10, 0, 10)
    Knob.Position = UDim2.new(0, Default and 16 or 2, 0.5, -5)
    Knob.BackgroundColor3 = Color3.fromRGB(237, 237, 237)
    Knob.BorderSizePixel = 0
    Knob.Parent = Button

    Corner(Knob, 20)

    local TextLabel = Label(
        Holder,
        Text,
        11,
        Colors.Text2,
        Enum.Font.Gotham
    )

    TextLabel.Size = UDim2.new(0, 115, 1, 0)
    TextLabel.Position = UDim2.new(0, 38, 0, 0)

    local State = {
        Value = Default
    }

    local Hitbox = Instance.new("TextButton")
    Hitbox.Size = UDim2.new(1, 0, 1, 0)
    Hitbox.BackgroundTransparency = 1
    Hitbox.Text = ""
    Hitbox.Parent = Holder

    Hitbox.MouseButton1Click:Connect(function()
        State.Value = not State.Value

        Tween(Button, 0.12, {
            BackgroundColor3 = State.Value
                and Colors.Accent
                or Colors.Surface3
        }):Play()

        Tween(Knob, 0.12, {
            Position = UDim2.new(
                0,
                State.Value and 16 or 2,
                0.5,
                -5
            )
        }):Play()
    end)

    return State
end

