local Busy = false

ObfButton.MouseButton1Click:Connect(function()
    if Busy then
        return
    end

    local Source = InputBox.Text

    if Source == "" then
        SetStatus("No input source.", Colors.Accent)
        return
    end

    Busy = true
    SetStatus("Obfuscating...", Colors.Text2)

    Tween(ObfButton, 0.1, {
        BackgroundColor3 = Color3.fromRGB(190, 54, 43)
    }):Play()

    task.defer(function()
        local Result, Err = Obfuscate(Source, {
            RenameLocals = OptRenameLocals.Value,
            EncodeStrings = OptEncodeStrings.Value,
            InsertJunk = OptInsertJunk.Value,
            ObfuscateNums = OptObfNums.Value,
            StripComments = OptStripComments.Value,
            Minify = OptMinify.Value
        })

        if Err then
            OutputBox.Text = ""
            SetStatus(
                "Error: " .. tostring(Err),
                Colors.Accent
            )
        else
            OutputBox.Text = Result

            local InputLength = #Source
            local OutputLength = #Result
            local Ratio = math.floor(
                (OutputLength / math.max(InputLength, 1)) * 100
            )

            SetStatus(
                "Done · "
                    .. tostring(InputLength)
                    .. " → "
                    .. tostring(OutputLength)
                    .. " chars · "
                    .. tostring(Ratio)
                    .. "%",
                Colors.Green
            )
        end

        Tween(ObfButton, 0.1, {
            BackgroundColor3 = Colors.Accent
        }):Play()

        Busy = false
    end)
end)

CopyButton.MouseButton1Click:Connect(function()
    local Text = OutputBox.Text

    if Text == "" then
        SetStatus("Nothing to copy.", Colors.Accent)
        return
    end

    local Copied = false

    if type(setclipboard) == "function" then
        Copied = pcall(setclipboard, Text)
    elseif type(toclipboard) == "function" then
        Copied = pcall(toclipboard, Text)
    elseif type(Clipboard) == "table"
        and type(Clipboard.set) == "function" then

        Copied = pcall(Clipboard.set, Text)
    end

    if Copied then
        local Previous = CopyButton.Text

        CopyButton.Text = "Copied"
        CopyButton.TextColor3 = Colors.Green

        SetStatus(
            "Output copied to clipboard.",
            Colors.Green
        )

        task.delay(1.4, function()
            if CopyButton.Parent then
                CopyButton.Text = Previous
                CopyButton.TextColor3 = Colors.Text2
            end
        end)
    else
        SetStatus(
            "Clipboard API unavailable.",
            Colors.Accent
        )
    end
end)

