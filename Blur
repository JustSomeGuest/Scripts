local function RandomName(Length)
    Length = Length or math.random(8, 16)

    local Consonants = "bcdfghjklmnpqrstvwxyz"
    local Vowels = "aeiou"
    local Name = {}
    local UseVowel = math.random(0, 1) == 0

    for i = 1, Length do
        if UseVowel then
            local Idx = math.random(1, #Vowels)
            Name[i] = Vowels:sub(Idx, Idx)
        else
            local Idx = math.random(1, #Consonants)
            Name[i] = Consonants:sub(Idx, Idx)
        end

        UseVowel = not UseVowel
    end

    if math.random(0, 1) == 0 then
        Name[1] = Name[1]:upper()
    end

    return table.concat(Name)
end

local function ObfuscatorUsed()
    local Used = {}

    return {
        New = function(self, Base)
            local Name

            repeat
                Name = (Base or "") .. RandomName(math.random(6, 14))
            until not Used[Name]
                and not LuauKeywords[Name]
                and not LuauBuiltinsSet[Name]

            Used[Name] = true

            return Name
        end
    }
end

local TokenType = {
    Name = "Name",
    String = "String",
    Number = "Number",
    Op = "Op",
    Punct = "Punct",
    Keyword = "Keyword",
    Newline = "Newline",
    Space = "Space",
    Comment = "Comment",
    LongString = "LongString",
    Eof = "Eof",
}

local function Tokenize(Source)
    local Tokens = {}
    local Pos = 1
    local Len = #Source

    local function Peek(Offset)
        Offset = Offset or 0
        return Source:sub(Pos + Offset, Pos + Offset)
    end

    local function Advance(N)
        N = N or 1

        local Ch = Source:sub(Pos, Pos + N - 1)

        Pos = Pos + N

        return Ch
    end

    local function MatchLongBracket()
        if Peek() ~= "[" then
            return nil
        end

        local Level = 0
        local Start = Pos
        local I = Pos + 1

        while Source:sub(I, I) == "=" do
            Level = Level + 1
            I = I + 1
        end

        if Source:sub(I, I) ~= "[" then
            return nil
        end

        local OpenLen = Level + 2

        Pos = Pos + OpenLen

        local Close = "]" .. ("="):rep(Level) .. "]"
        local ClosePos = Source:find(Close, Pos, true)

        if not ClosePos then
            local Remaining = Source:sub(Pos)

            Pos = Len + 1

            return Source:sub(Start, Start + OpenLen - 1) .. Remaining
        end

        local Content = Source:sub(Start, ClosePos + #Close - 1)

        Pos = ClosePos + #Close

        return Content
    end

    while Pos <= Len do
        local Ch = Peek()

        if Ch == "\n" then
            Advance()

            table.insert(Tokens, {
                Type = TokenType.Newline,
                Value = "\n"
            })

        elseif Ch == " " or Ch == "\t" or Ch == "\r" then
            local Start = Pos

            while Pos <= Len
                and (Peek() == " " or Peek() == "\t" or Peek() == "\r") do
                Advance()
            end

            table.insert(Tokens, {
                Type = TokenType.Space,
                Value = Source:sub(Start, Pos - 1)
            })

        elseif Ch == "-" and Peek(1) == "-" then
            Advance(2)

            local Long = MatchLongBracket()

            if Long then
                table.insert(Tokens, {
                    Type = TokenType.Comment,
                    Value = "--" .. Long,
                    IsLong = true
                })
            else
                local Start = Pos

                while Pos <= Len and Peek() ~= "\n" do
                    Advance()
                end

                table.insert(Tokens, {
                    Type = TokenType.Comment,
                    Value = "--" .. Source:sub(Start, Pos - 1)
                })
            end

        elseif Ch == "[" then
            local SavePos = Pos
            local Long = MatchLongBracket()

            if Long then
                table.insert(Tokens, {
                    Type = TokenType.LongString,
                    Value = Long
                })
            else
                Pos = SavePos
                Advance()

                table.insert(Tokens, {
                    Type = TokenType.Punct,
                    Value = "["
                })
            end

        elseif Ch == '"' or Ch == "'" then
            local Quote = Advance()
            local Parts = { Quote }

            while Pos <= Len do
                local C = Peek()

                if C == "\\" then
                    Parts[#Parts + 1] = Advance()

                    if Pos <= Len then
                        Parts[#Parts + 1] = Advance()
                    end
                elseif C == Quote then
                    Parts[#Parts + 1] = Advance()
                    break
                elseif C == "\n" then
                    break
                else
                    Parts[#Parts + 1] = Advance()
                end
            end

            table.insert(Tokens, {
                Type = TokenType.String,
                Value = table.concat(Parts)
            })

        elseif Ch:match("%d")
            or (Ch == "." and Peek(1):match("%d")) then

            local Start = Pos

            if Ch == "0" and (Peek(1) == "x" or Peek(1) == "X") then
                Advance(2)

                while Pos <= Len and Peek():match("[%x_]") do
                    Advance()
                end
            elseif Ch == "0" and (Peek(1) == "b" or Peek(1) == "B") then
                Advance(2)

                while Pos <= Len
                    and (Peek() == "0" or Peek() == "1" or Peek() == "_") do
                    Advance()
                end
            else
                while Pos <= Len and Peek():match("[%d_]") do
                    Advance()
                end

                if Pos <= Len
                    and Peek() == "."
                    and Peek(1):match("%d") then

                    Advance()

                    while Pos <= Len and Peek():match("[%d_]") do
                        Advance()
                    end
                end

                if Pos <= Len and (Peek() == "e" or Peek() == "E") then
                    Advance()

                    if Pos <= Len
                        and (Peek() == "+" or Peek() == "-") then
                        Advance()
                    end

                    while Pos <= Len and Peek():match("%d") do
                        Advance()
                    end
                end
            end

            table.insert(Tokens, {
                Type = TokenType.Number,
                Value = Source:sub(Start, Pos - 1)
            })

        elseif Ch:match("[%a_]") then
            local Start = Pos

            while Pos <= Len and Peek():match("[%w_]") do
                Advance()
            end

            local Word = Source:sub(Start, Pos - 1)

            if LuauKeywords[Word] then
                table.insert(Tokens, {
                    Type = TokenType.Keyword,
                    Value = Word
                })
            else
                table.insert(Tokens, {
                    Type = TokenType.Name,
                    Value = Word
                })
            end

        elseif Ch == "." then
            if Peek(1) == "." and Peek(2) == "." then
                Advance(3)

                table.insert(Tokens, {
                    Type = TokenType.Op,
                    Value = "..."
                })
            elseif Peek(1) == "." then
                Advance(2)

                table.insert(Tokens, {
                    Type = TokenType.Op,
                    Value = ".."
                })
            else
                Advance()

                table.insert(Tokens, {
                    Type = TokenType.Punct,
                    Value = "."
                })
            end

        elseif Ch == "=" then
            if Peek(1) == "=" then
                Advance(2)

                table.insert(Tokens, {
                    Type = TokenType.Op,
                    Value = "=="
                })
            else
                Advance()

                table.insert(Tokens, {
                    Type = TokenType.Op,
                    Value = "="
                })
            end

        elseif Ch == "~" and Peek(1) == "=" then
            Advance(2)

            table.insert(Tokens, {
                Type = TokenType.Op,
                Value = "~="
            })

        elseif Ch == "<" then
            if Peek(1) == "=" then
                Advance(2)

                table.insert(Tokens, {
                    Type = TokenType.Op,
                    Value = "<="
                })
            elseif Peek(1) == "<" then
                Advance(2)

                table.insert(Tokens, {
                    Type = TokenType.Op,
                    Value = "<<"
                })
            else
                Advance()

                table.insert(Tokens, {
                    Type = TokenType.Op,
                    Value = "<"
                })
            end

        elseif Ch == ">" then
            if Peek(1) == "=" then
                Advance(2)

                table.insert(Tokens, {
                    Type = TokenType.Op,
                    Value = ">="
                })
            elseif Peek(1) == ">" then
                Advance(2)

                table.insert(Tokens, {
                    Type = TokenType.Op,
                    Value = ">>"
                })
            else
                Advance()

                table.insert(Tokens, {
                    Type = TokenType.Op,
                    Value = ">"
                })
            end

        elseif Ch == "/" then
            if Peek(1) == "/" then
                Advance(2)

                table.insert(Tokens, {
                    Type = TokenType.Op,
                    Value = "//"
                })
            else
                Advance()

                table.insert(Tokens, {
                    Type = TokenType.Op,
                    Value = "/"
                })
            end

        else
            Advance()

            table.insert(Tokens, {
                Type = TokenType.Punct,
                Value = Ch
            })
        end
    end

    table.insert(Tokens, {
        Type = TokenType.Eof,
        Value = ""
    })

    return Tokens
end

local function CollectLocals(Tokens)
    local Locals = {}
    local I = 1

    while I <= #Tokens do
        local Tok = Tokens[I]

        if Tok.Type == TokenType.Keyword and Tok.Value == "local" then
            local J = I + 1

            while J <= #Tokens
                and (
                    Tokens[J].Type == TokenType.Space
                    or Tokens[J].Type == TokenType.Newline
                ) do
                J = J + 1
            end

            if J <= #Tokens
                and Tokens[J].Type == TokenType.Keyword
                and Tokens[J].Value == "function" then

                local K = J + 1

                while K <= #Tokens
                    and (
                        Tokens[K].Type == TokenType.Space
                        or Tokens[K].Type == TokenType.Newline
                    ) do
                    K = K + 1
                end

                if K <= #Tokens and Tokens[K].Type == TokenType.Name then
                    Locals[Tokens[K].Value] = true
                end
            elseif J <= #Tokens and Tokens[J].Type == TokenType.Name then
                local K = J

                while K <= #Tokens do
                    local T2 = Tokens[K]

                    if T2.Type == TokenType.Name then
                        Locals[T2.Value] = true
                    elseif T2.Type == TokenType.Punct and T2.Value == "," then
                    elseif T2.Type == TokenType.Space then
                    else
                        break
                    end

                    K = K + 1
                end
            end
        end

        I = I + 1
    end

    return Locals
end

local function IsAfterDot(Tokens, Index)
    local I = Index - 1

    while I >= 1 and Tokens[I].Type == TokenType.Space do
        I = I - 1
    end

    if I >= 1
        and Tokens[I].Type == TokenType.Punct
        and Tokens[I].Value == "." then
        return true
    end

    if I >= 1
        and Tokens[I].Type == TokenType.Punct
        and Tokens[I].Value == ":" then
        return true
    end

    return false
end

local function IsBeforeParen(Tokens, Index)
    local I = Index + 1

    while I <= #Tokens and Tokens[I].Type == TokenType.Space do
        I = I + 1
    end

    return false
end

local function BuildRenameMap(Tokens, LocalSet, Names)
    local Map = {}

    for Name, _ in pairs(LocalSet) do
        if not LuauKeywords[Name] and not LuauBuiltinsSet[Name] then
            Map[Name] = Names:New()
        end
    end

    return Map
end

local function EncodeString(Str)
    local Inner = Str:sub(2, -2)
    local Quote = Str:sub(1, 1)
    local Parts = {}
    local I = 1

    while I <= #Inner do
        local C = Inner:sub(I, I)

        if C == "\\" and I < #Inner then
            Parts[#Parts + 1] = C .. Inner:sub(I + 1, I + 1)
            I = I + 2
        else
            local Byte = C:byte()

            Parts[#Parts + 1] = "\\x" .. string.format("%02x", Byte)

            I = I + 1
        end
    end

    return Quote .. table.concat(Parts) .. Quote
end

local function ObfuscateNumber(NumStr)
    local N = tonumber(NumStr)

    if not N then
        return NumStr
    end

    if N ~= math.floor(N) then
        return NumStr
    end

    if N < 0 or N > 1000000 then
        return NumStr
    end

    local A = math.random(1, 300)
    local B = math.random(1, 300)
    local C = math.floor(N) - A - B

    return "("
        .. tostring(A)
        .. "+"
        .. tostring(B)
        .. "+"
        .. tostring(C)
        .. ")"
end

